# Copier ce fichier en .env (non versionné) pour surcharger les valeurs par défaut.
# Aucune valeur secrète ici : tout est fictif (projet pédagogique, authentification simulée).

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=3001
# Origines autorisées par CORS, séparées par des virgules (serveur de dev Vite par défaut)
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# Durée de validité d'un brouillon de commande, en minutes
DRAFT_TTL_MINUTES=30
# Durée de validité d'une session de connexion QR de la borne, en secondes
LOGIN_SESSION_TTL_SECONDS=120
# Authentification SIMULÉE : à mettre à false pour désactiver la connexion de démonstration
MOCK_AUTH_ENABLED=true

# --- Web (apps/web), variables lues par Vite (préfixe VITE_) ---
VITE_API_URL=http://localhost:3001
# Identifiant de borne par défaut pour les écrans /kiosk
VITE_DEFAULT_KIOSK_ID=kiosk-01
# Active le panneau de debug et les simulateurs hors mode développement
VITE_ENABLE_DEV_TOOLS=false
